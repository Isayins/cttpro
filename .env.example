# Frontend
VITE_API_BASE_URL=http://localhost:9091
VITE_API_TIMEOUT_MS=15000
VITE_IDLE_LOGOUT_MINUTES=120

# Docker Compose database defaults
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=idncar
JWT_SECRET=

# Docker Compose service ports
JAVA_BACKEND_PORT=9091
MYSQL_PORT=3306
REDIS_PORT=6379

# Java backend mail
SPRING_MAIL_HOST=smtp.163.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=pppopidc@163.com
SPRING_MAIL_PASSWORD=change-me-mail-authorization-code
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_SMTP_SSL_ENABLE=true
APP_MAIL_FROM=pppopidc@163.com
APP_MAIL_MOCK_ENABLED=false
APP_MAIL_LOGO_URL=

# Optional payment settings
APP_PAYMENT_MANUAL_CONFIRM_ENABLED=true
APP_PAYMENT_MANUAL_CONFIRM_RECIPIENTS=
APP_PAYMENT_ALIPAY_ENABLED=false
APP_PAYMENT_ALIPAY_APP_ID=
APP_PAYMENT_ALIPAY_PRIVATE_KEY=
APP_PAYMENT_ALIPAY_ALIPAY_PUBLIC_KEY=
APP_PAYMENT_ALIPAY_NOTIFY_URL=
APP_PAYMENT_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
APP_PAYMENT_ALIPAY_ENCRYPT_ENABLED=true
APP_PAYMENT_ALIPAY_ENCRYPT_TYPE=AES
APP_PAYMENT_ALIPAY_ENCRYPT_KEY=

# V免签已内置在后台管理中配置，无需单独填写 PHP 后台地址或通讯密钥环境变量。
