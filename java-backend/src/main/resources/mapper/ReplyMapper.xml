<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.idncar.mapper.ReplyMapper">

    <select id="selectByPostId" resultType="com.idncar.model.entity.Reply">
        SELECT * FROM replies WHERE post_id = #{postId} ORDER BY create_time DESC
    </select>

</mapper>
