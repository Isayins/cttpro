{
  "name": "cttpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test": "vitest run",
    "build": "tsc -b && vite build --config vite.config.ts",
    "package:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-all.ps1",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check": "npm test && npm run lint && npm run typecheck && npm run build",
    "check:all": "node scripts/check-all.mjs",
    "format": "prettier --write \"README.md\" \"docker-compose.yml\" \"deploy/ubuntu/**/*.yml\" \"deploy/ubuntu/**/*.md\" \".github/workflows/**/*.yml\" \"package.json\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"eslint.config.js\"",
    "format:check": "prettier --check \"README.md\" \"docker-compose.yml\" \"deploy/ubuntu/**/*.yml\" \"deploy/ubuntu/**/*.md\" \".github/workflows/**/*.yml\" \"package.json\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"eslint.config.js\"",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.27.4",
    "jsqr": "^1.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^6.2.2",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.8"
  }
}
